// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum AuthProvider {
  local
  google
  facebook
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  blocked
  deleted
  expired
  pending_verification
}

enum ThreadStatus {
  draft
  planning
  confirmed
  completed
  cancelled
  dropped
}

enum ThreadSubStatus {
  understanding
  timeline_preparation
  timeline_finalized
}

enum MessageRole {
  user
  assistant
}

enum MessageType {
  text
  markdown
  image
  card
  json
  error
}

enum MessageStatus {
  sent
  delivered
  read
  failed
}

enum TimelineStatus {
  draft
  in_progress
  ready
  confirmed
  archived
}

enum BudgetType {
  confirmed
  approx
}

enum NodeType {
  start
  end
  task_node
  representation_node
  action
  representation
  additional_input
}

enum NodeStatus {
  active
  inactive
  in_progress
}

enum DisplayDateType {
  date
  date_range
  time
  time_range
}

enum TasksStatus {
  pending
  in_progress
  completed
}

enum RecommendationStatus {
  pending
  reviewed
  accepted
}

enum ElementType {
  task
  recommendation
}

enum ElementStatus {
  confirmed
  pending
  completed
  cancelled
}

enum NotificationType {
  flight_delay
  flight_change
  weather_alert
  booking_confirmation
  reminder
  travel_update
  system
}

enum NotificationPriority {
  low
  medium
  high
  urgent
}

enum DisplayType {
  mobile
  desktop
  all
}

enum SuggestionCategory {
  long_time_plan
  short_time_plan
  weekend_plan
  quick_trip
}

// ============================================================================
// MODELS
// ============================================================================

/// User account - email is the primary identifier
model User {
  email                 String    @id @db.VarChar(255)
  name                  String    @db.VarChar(255)
  passwordHash          String?   @map("password_hash") @db.VarChar(255)
  authProvider          AuthProvider @map("auth_provider")
  authProviderId        String?   @map("auth_provider_id") @db.VarChar(255)
  role                  UserRole  @default(user)
  status                UserStatus @default(active)
  emailVerified         Boolean   @default(false) @map("email_verified")
  phoneNumber           String?   @map("phone_number") @db.VarChar(20)
  phoneNumberVerified   Boolean   @default(false) @map("phone_number_verified")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  members               Member[]
  threads               Thread[]
  refreshTokens         RefreshToken[]
  notificationPreference NotificationPreference?

  @@index([status])
  @@index([phoneNumber])
  @@index([authProvider, authProviderId])
  @@map("users")
}

/// Member within a user's account (family members, travel companions)
model Member {
  id                    String    @id @default(uuid()) @db.Uuid
  userEmail             String    @map("user_email") @db.VarChar(255)
  avatar                String?   @db.VarChar(500)
  name                  String    @db.VarChar(255)
  isPrimaryMember       Boolean   @default(false) @map("is_primary_member")
  dob                   DateTime? @db.Date
  relation              String?   @db.VarChar(100)
  interestProfile       Json?     @map("interest_profile") @db.JsonB
  locationDetails       Json?     @map("location_details") @db.JsonB
  travelProfile         Json?     @map("travel_profile") @db.JsonB
  travelInstructions    Json?     @map("travel_instructions") @db.JsonB
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  user                  User      @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@index([userEmail])
  @@index([userEmail, isPrimaryMember])
  @@map("members")
}

/// Conversation/planning session thread
model Thread {
  id                    String    @id @default(uuid()) @db.Uuid
  userEmail             String?   @map("user_email") @db.VarChar(255)
  timelineId            String?   @unique @map("timeline_id") @db.Uuid
  timelineReadyProgress Int       @default(0) @map("timeline_ready_progress")
  status                ThreadStatus @default(draft)
  subStatus             ThreadSubStatus? @map("sub_status")
  summary               String?   @db.VarChar(500)
  versionDetails        Json?     @map("version_details") @db.JsonB
  isConfirmed           Boolean   @default(false) @map("is_confirmed")
  view                  String    @default("init-chat") @db.VarChar(50)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  user                  User?     @relation(fields: [userEmail], references: [email], onDelete: SetNull)
  timeline              Timeline? @relation(fields: [timelineId], references: [id], onDelete: SetNull)
  threadContext         ThreadContext?
  messages              Message[]
  notifications         Notification[]

  @@index([userEmail])
  @@index([status])
  @@map("threads")
}

/// Complete thread context for timeline creation
model ThreadContext {
  id                    String    @id @default(uuid()) @db.Uuid
  threadId              String    @unique @map("thread_id") @db.Uuid
  budget                Decimal?  @db.Decimal(12, 2)
  currency              String    @default("USD") @db.VarChar(3)
  startDate             DateTime? @map("start_date") @db.Date
  endDate               DateTime? @map("end_date") @db.Date
  planSummary           Json?     @map("plan_summary") @db.JsonB
  travellersDetails     Json?     @map("travellers_details") @db.JsonB
  journeyContext        String?   @map("journey_context") @db.Text
  generalInstructions   Json?     @map("general_instructions") @db.JsonB
  userActions           Json?     @map("user_actions") @db.JsonB
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  thread                Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("thread_contexts")
}

/// Individual messages in a thread
model Message {
  id                    String    @id @default(uuid()) @db.Uuid
  threadId              String    @map("thread_id") @db.Uuid
  senderId              String    @map("sender_id") @db.VarChar(255)
  role                  MessageRole
  type                  MessageType
  content               Bytes     @db.ByteA
  status                MessageStatus @default(sent)
  metadata              Json?     @db.JsonB
  createdAt             DateTime  @default(now()) @map("created_at")

  // Relations
  thread                Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([threadId, createdAt])
  @@map("messages")
}

/// Timeline container for travel plans
model Timeline {
  id                    String    @id @default(uuid()) @db.Uuid
  renderingStyle        String    @default("default") @map("rendering_style") @db.VarChar(50)
  startDate             DateTime? @map("start_date") @db.Date
  endDate               DateTime? @map("end_date") @db.Date
  budget                Decimal   @default(0) @db.Decimal(12, 2)
  budgetType            BudgetType @default(approx) @map("budget_type")
  adultsCount           Int       @default(1) @map("adults_count")
  childrenCount         Int       @default(0) @map("children_count")
  timelineContext       String?   @map("timeline_context") @db.Text
  status                TimelineStatus @default(draft)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  thread                Thread?
  nodes                 TimelineNode[]
  elements              TimelineNodeElement[]
  notifications         Notification[]

  @@index([status])
  @@map("timelines")
}

/// Individual nodes in the timeline
model TimelineNode {
  id                    String    @id @default(uuid()) @db.Uuid
  timelineId            String    @map("timeline_id") @db.Uuid
  nodeVersion           Int       @default(1) @map("node_version")
  status                NodeStatus @default(active)
  order                 Int
  type                  NodeType
  subtype               String?   @db.VarChar(50)
  displayTitle          String?   @map("display_title") @db.VarChar(255)
  displaySubtitle       String?   @map("display_subtitle") @db.VarChar(255)
  displayIcon           Json?     @map("display_icon") @db.JsonB
  nodeSummary           Json?     @map("node_summary") @db.JsonB
  tasksStatus           TasksStatus? @map("tasks_status")
  recommendationStatus  RecommendationStatus? @map("recommendation_status")
  displayDateType       DisplayDateType? @map("display_date_type")
  displayDateLabel      String?   @map("display_date_label") @db.VarChar(100)
  displayDateStart      DateTime? @map("display_date_start")
  displayDateEnd        DateTime? @map("display_date_end")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  timeline              Timeline  @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  elements              TimelineNodeElement[]

  @@index([timelineId])
  @@index([timelineId, order])
  @@index([type])
  @@index([status])
  @@map("timeline_nodes")
}

/// Unified table for tasks and recommendations within nodes
model TimelineNodeElement {
  id                    String    @id @default(uuid()) @db.Uuid
  timelineNodeId        String    @map("timeline_node_id") @db.Uuid
  timelineId            String    @map("timeline_id") @db.Uuid
  elementType           ElementType @map("element_type")
  elementCategory       String    @map("element_category") @db.VarChar(100)
  elementIcon           Json?     @map("element_icon") @db.JsonB
  title                 String    @db.VarChar(255)
  description           String?   @db.Text
  priceRange            Json?     @map("price_range") @db.JsonB
  status                ElementStatus @default(pending)
  priority              Int       @default(1)
  order                 Int       @default(0)
  metadata              Json?     @db.JsonB
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  timelineNode          TimelineNode @relation(fields: [timelineNodeId], references: [id], onDelete: Cascade)
  timeline              Timeline  @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([timelineNodeId])
  @@index([timelineId])
  @@index([elementType])
  @@index([status])
  @@map("timeline_node_elements")
}

/// Notifications
model Notification {
  id                    String    @id @default(uuid()) @db.Uuid
  threadId              String?   @map("thread_id") @db.Uuid
  timelineId            String?   @map("timeline_id") @db.Uuid
  version               Int?
  title                 String    @db.VarChar(255)
  message               String    @db.Text
  priority              NotificationPriority @default(medium)
  type                  NotificationType
  actionUrl             String?   @map("action_url") @db.VarChar(500)
  isRead                Boolean   @default(false) @map("is_read")
  metadata              Json?     @db.JsonB
  createdAt             DateTime  @default(now()) @map("created_at")

  // Relations
  thread                Thread?   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  timeline              Timeline? @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([timelineId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

/// User notification preferences
model NotificationPreference {
  id                    String    @id @default(uuid()) @db.Uuid
  userEmail             String    @unique @map("user_email") @db.VarChar(255)
  emailNotifications    Boolean   @default(true) @map("email_notifications")
  pushNotifications     Boolean   @default(true) @map("push_notifications")
  flightUpdates         Boolean   @default(true) @map("flight_updates")
  weatherAlerts         Boolean   @default(true) @map("weather_alerts")
  bookingReminders      Boolean   @default(true) @map("booking_reminders")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  user                  User      @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Suggestion templates for home page
model SuggestionTemplate {
  id                    String    @id @default(uuid()) @db.Uuid
  priority              Int
  templateText          String    @map("template_text") @db.Text
  description           String?   @db.VarChar(255)
  displayType           DisplayType @default(all) @map("display_type")
  category              SuggestionCategory
  localityLat           Float?    @map("locality_lat")
  localityLng           Float?    @map("locality_lng")
  localityRadiusKm      Int       @default(50) @map("locality_radius_km")
  placeholderOptions    Json?     @map("placeholder_options") @db.JsonB
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([priority])
  @@index([isActive])
  @@index([category])
  @@index([localityLat, localityLng])
  @@map("suggestion_templates")
}

/// Refresh tokens for JWT authentication
model RefreshToken {
  id                    String    @id @default(uuid()) @db.Uuid
  userEmail             String    @map("user_email") @db.VarChar(255)
  tokenHash             String    @unique @map("token_hash") @db.VarChar(255)
  deviceInfo            String?   @map("device_info") @db.VarChar(255)
  ipAddress             String?   @map("ip_address") @db.VarChar(45)
  expiresAt             DateTime  @map("expires_at")
  revokedAt             DateTime? @map("revoked_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  // Relations
  user                  User      @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@index([userEmail])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
