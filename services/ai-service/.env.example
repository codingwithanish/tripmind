# Google AI API Key (required for Gemini models)
GOOGLE_API_KEY=your-google-api-key-here

# Model Configuration
DEFAULT_MODEL=gemini-2.0-flash

# Server Configuration
HOST=0.0.0.0
PORT=8001

# Execution Mode: "actual" or "dummy"
# - actual: Uses real AI agents (default if not set)
# - dummy: Returns mock data from dummy_data.py (for testing)
AI_EXECUTION_MODE=actual
